# Apex Comfort Systems — environment
#
# Copy to .env.local for development, and set these in the hosting provider
# before launch. Nothing here has a default that works in production: the
# Server Action THROWS if transactional email is unconfigured in production
# (lib/actions/submit-lead.ts), which is deliberate — a silently swallowed
# lead is worse than a visible failure, and G.2's error state hands the user a
# live phone number so a failure never becomes a dead end.

# --- Transport (Appendix G.3) -----------------------------------------------
# Next.js Server Action -> transactional email (Resend) -> dispatch inbox.
# REQUIRED IN PRODUCTION. Without these the quote and callback forms return
# G.2's "We couldn't send that. Call us at ..." error instead of converting.
RESEND_API_KEY=
DISPATCH_INBOX=
DISPATCH_FROM=leads@apexcomfortsystems.com

# --- Spam protection, layer 3 (Appendix G.4) --------------------------------
# Cloudflare Turnstile, INVISIBLE MODE. Explicitly not reCAPTCHA v2 checkbox:
# it inserts a click between intent and conversion, costs ~120KB of
# third-party JS against the J.1 budget, and raises a WCAG 3.3.8 concern.
#
# If unset, verification is skipped and the OTHER THREE LAYERS STILL APPLY
# (honeypot, 2-second time floor, 5-per-10-minutes-per-IP rate limit). That is
# a development convenience, not a production posture — set it before launch.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Site ---------------------------------------------------------------
# Used for canonicals, Open Graph URLs, sitemap.xml and the JSON-LD @id values.
# Must match the single host the domain resolves to (F.2) — www and apex must
# already collapse to one before launch.
NEXT_PUBLIC_SITE_URL=https://www.apexcomfortsystems.com

# --- Measurement (§8.6, J.7) -------------------------------------------------
# GA4 measurement ID. Loads `afterInteractive` through a consent-mode-aware
# wrapper, so it never counts against J.5's 0KB above-the-fold budget.
# Unset in development: the dataLayer still fills, so events are inspectable
# without a live property.
#
# IN THE GA4 PROPERTY, mark `generate_lead` AND `phone_click` as KEY EVENTS.
# Phone is the primary conversion channel (§1.4: 60-70% of HVAC conversions
# arrive by phone) and must not be configured as secondary.
NEXT_PUBLIC_GA_ID=
